datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  
  // Custom Fields
  role          String    @default("STUDENT") // ADMIN, TEACHER, TUTOR, STUDENT
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  
  // Registration Data
  cpf           String?   // @unique constraint removed for simplicity in dev, can add later
  phone         String?
  city          String?
  school        String?
  jobTitle      String?
  teachingTime  String?
  educationLevel String?
  trainingArea  String?

  educoins      Int       @default(0)
  xp            Int       @default(0)
  level         Int       @default(1)
  
  // Documents & Special Status
  documentsUrl       String?
  quotaDocumentsUrl  String?
  pcdDocumentsUrl    String?
  quotaType          String? // INDIGENOUS, QUILOMBOLA
  isPcd              Boolean   @default(false)
  
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
