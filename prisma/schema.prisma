datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model UserProgress {
  id          String   @id @default(cuid())
  userId      String
  moduleId    String
  nodeId      String
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId, nodeId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  username      String?   @unique
  password      String?
  
  // Custom Fields
  role          String    @default("STUDENT") // ADMIN, TEACHER, TUTOR, STUDENT
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  
  // Avatar Configuration
  avatarConfig  String?   // JSON string storing the avatar configuration
  unlockedItems String    @default("[]") // JSON string array of unlocked item IDs  // Registration Data
  cpf           String?   // @unique constraint removed for simplicity in dev, can add later
  phone         String?
  city          String?
  school        String?
  jobTitle      String?
  teachingTime  String?
  educationLevel String?
  trainingArea  String?

  // Gamification & Progress
  educoins      Int            @default(0)
  progress      UserProgress[]
  xp            Int       @default(0)
  level         Int       @default(1)
  
  // Documents & Special Status
  documentsUrl       String?
  quotaDocumentsUrl  String? // URL for quota documents
  pcdDocumentsUrl    String? // URL for PcD documents
  quotaType          String? // INDIGENOUS, QUILOMBOLA
  isPcd              Boolean   @default(false)
  
  accounts      Account[]
  sessions      Session[]
  
  quizResults   QuizResult[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Registration {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  cpf            String   @unique
  phone          String
  city           String
  school         String
  jobTitle       String
  teachingTime   String
  educationLevel String
  trainingArea   String
  
  quotaType      String?  // AMPLA, INDIGENA, QUILOMBOLA, PCD
  fileUrl        String?  // Path to the uploaded PDF
  
  status         String   @default("PENDING") // PENDING, EXPORTED
  createdAt      DateTime @default(now())
}

model QuizResult {
  id          String   @id @default(cuid())
  userId      String
  moduleId    String
  score       Int      // Percentage 0-100
  passed      Boolean
  completedAt DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
